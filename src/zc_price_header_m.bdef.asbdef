projection;
strict ( 1 );
use draft;

define behavior for ZC_PRICE_HEADER_M alias Header
//use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item {create; with draft;}
}

define behavior for ZC_PRICE_ITEM_M alias Item
//use etag
{
  use update;
  use delete;
  use association _Header{ with draft; }
}